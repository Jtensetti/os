#!/usr/bin/env bash
# forge-sandbox <app-dir> <data-dir> -- <command...>
#
# Runs an app process with bubblewrap: it sees the system read-only, its own
# app and data directories read-write, plus internet and any extra folders
# its forge.json asks for.

set -euo pipefail

app="$1" data="$2"; shift 2
[[ "${1:-}" == "--" ]] && shift

unsandboxed() { cd "$app" && exec "$@"; }
[[ "${FORGE_NO_SANDBOX:-0}" == 1 ]] && unsandboxed "$@"
if ! command -v bwrap >/dev/null; then
  echo "forge: bubblewrap saknas — kör UTAN sandlåda" >&2
  unsandboxed "$@"
fi
# Containers and kernels without (AppArmor-permitted) user namespaces
# cannot run bwrap. Say so instead of failing the app.
if ! bwrap --ro-bind / / --unshare-all true 2>/dev/null; then
  echo "forge: sandlådan kan inte startas här (user namespaces blockerade) — kör UTAN sandlåda" >&2
  unsandboxed "$@"
fi

perm() { jq -r "$1 // empty" "$app/forge.json" 2>/dev/null || true; }

args=(
  --ro-bind /usr /usr --ro-bind /etc /etc
  --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 --symlink usr/sbin /sbin
  --proc /proc --dev /dev --tmpfs /tmp --tmpfs "$HOME"
  --bind "$app" "$app" --bind "$data" "$data"
  --ro-bind-try "$HOME/.config/forge/app.css" "$HOME/.config/forge/app.css"
  --die-with-parent --new-session --unshare-all
  --setenv HOME "$HOME" --chdir "$app"
)

# Internet is on by default; an app can opt out with "network": false
# (apps with a local web server always keep it so the window can reach them).
if [[ "$(perm .permissions.network)" != false || -n "$(perm .server)" || "${FORGE_SANDBOX_NET:-0}" == 1 ]]; then
  args+=(--share-net --ro-bind-try /run/systemd/resolve /run/systemd/resolve)
fi

# Extra folders, e.g. "~/Documents" or "~/Music:ro".
while IFS= read -r p; do
  [[ -z "$p" ]] && continue
  mode=rw
  if [[ "$p" == *:ro ]]; then mode=ro; p="${p%:ro}"; fi
  p="${p/#\~/$HOME}"
  [[ -e "$p" ]] || continue
  if [[ $mode == ro ]]; then args+=(--ro-bind "$p" "$p"); else args+=(--bind "$p" "$p"); fi
done < <(jq -r '.permissions.files[]? // empty' "$app/forge.json" 2>/dev/null)

# Optional display access for native GUI apps.
if [[ "$(perm .permissions.display)" == true ]]; then
  [[ -n "${XDG_RUNTIME_DIR:-}" && -n "${WAYLAND_DISPLAY:-}" ]] && \
    args+=(--ro-bind "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" \
           --setenv XDG_RUNTIME_DIR "$XDG_RUNTIME_DIR" --setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY")
  args+=(--dev-bind-try /dev/dri /dev/dri --ro-bind-try /tmp/.X11-unix /tmp/.X11-unix)
fi

exec bwrap "${args[@]}" "$@"

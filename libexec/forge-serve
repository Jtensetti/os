#!/usr/bin/env python3
"""forge-serve <app-dir> <port>: serve a Forge web app on 127.0.0.1.

Like `python3 -m http.server`, plus:
  /_forge/theme.css  the system theme (~/.config/forge/app.css), so every
                     app follows the desktop theme live
  hides .git and other dotfiles
"""
import functools
import http.server
import os
import sys
from pathlib import Path

THEME_CSS = Path.home() / ".config" / "forge" / "app.css"


class Handler(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/_forge/theme.css":
            body = THEME_CSS.read_bytes() if THEME_CSS.is_file() else b""
            self.send_response(200)
            self.send_header("Content-Type", "text/css; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        if any(part.startswith(".") for part in path.split("/") if part):
            self.send_error(404)
            return
        super().do_GET()

    def end_headers(self):
        self.send_header("Cache-Control", "no-cache")
        super().end_headers()

    def log_message(self, *args):
        pass


def main():
    if len(sys.argv) != 3:
        print("usage: forge-serve <app-dir> <port>", file=sys.stderr)
        sys.exit(2)
    directory, port = os.path.abspath(sys.argv[1]), int(sys.argv[2])
    handler = functools.partial(Handler, directory=directory)
    with http.server.ThreadingHTTPServer(("127.0.0.1", port), handler) as server:
        server.serve_forever()


if __name__ == "__main__":
    main()

/* Genererad av forge-theme ({{name}}). Serveras till alla appar som /_forge/theme.css */
:root {
  --bg: #{{bg}}; --surface: #{{surface}}; --text: #{{fg}}; --muted: #{{muted}};
  --accent: #{{accent}}; --accent-2: #{{accent2}}; --accent-text: #{{bg}}; --border: #{{border}};
  --red: #{{red}}; --green: #{{green}}; --yellow: #{{yellow}}; --blue: #{{blue}};
  color-scheme: {{mode}};
}

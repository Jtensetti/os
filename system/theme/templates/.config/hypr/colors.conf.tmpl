# Genererad av forge-theme ({{name}}) — ändra i ~/Forge/system/theme/ i stället.
$accent  = rgb({{accent}})
$accent2 = rgb({{accent2}})
$border  = rgb({{border}})
$bg      = rgb({{bg}})
$fg      = rgb({{fg}})

general {
  col.active_border = rgb({{accent}}) rgb({{accent2}}) 45deg
  col.inactive_border = rgba({{border}}aa)
}

decoration {
  shadow {
    color = rgba({{bg_alt}}ee)
  }
}

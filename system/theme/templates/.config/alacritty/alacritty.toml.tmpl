# Genererad av forge-theme ({{name}})
[window]
padding = { x = 16, y = 14 }
opacity = 0.9
decorations = "None"

[font]
normal = { family = "JetBrains Mono", style = "Regular" }
bold = { family = "JetBrains Mono", style = "Bold" }
size = 11.5

[cursor]
style = { shape = "Beam", blinking = "On" }

[colors.primary]
background = "#{{bg}}"
foreground = "#{{fg}}"

[colors.cursor]
cursor = "#{{accent}}"
text = "#{{bg}}"

[colors.selection]
background = "#{{surface}}"

[colors.normal]
black = "#{{bg_alt}}"
red = "#{{red}}"
green = "#{{green}}"
yellow = "#{{yellow}}"
blue = "#{{blue}}"
magenta = "#{{magenta}}"
cyan = "#{{cyan}}"
white = "#{{fg}}"

[colors.bright]
black = "#{{muted}}"
red = "#{{red}}"
green = "#{{green}}"
yellow = "#{{yellow}}"
blue = "#{{accent}}"
magenta = "#{{accent2}}"
cyan = "#{{cyan}}"
white = "#{{fg}}"

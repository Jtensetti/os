# Forge OS — apt-paket. En per rad. Ta bort en rad så avinstalleras paketet
# vid nästa 'forge system apply' (bara paket som Forge själv har lagt till).

# Skrivbord (Omarchy-stil: Hyprland + tangentbordet först)
greetd
tuigreet
hyprland
swaybg
hypridle
hyprlock
swaylock           # låsskärm utan 3D-grafik (forge-lock väljer)
xdg-desktop-portal-hyprland
waybar
fuzzel
mako-notifier
alacritty
grim
slurp
wl-clipboard
brightnessctl
playerctl
network-manager
blueman
pipewire
wireplumber
fonts-inter
fonts-jetbrains-mono
fonts-noto-color-emoji
papirus-icon-theme
libnotify-bin

# Lokal AI (Ollama installeras av hooks/root/25-ollama.sh)

# Forge-kärnan
apparmor           # tillåter bubblewrap-sandlådan (bwrap-userns-restrict)
zstd               # krävs av Ollamas installerare
xz-utils           # packar upp Node.js (hooks/root/18-nodejs.sh)
git
jq
curl
bubblewrap
python3
nodejs
npm
flatpak
python3-gi         # appfönster för webbappar (GTK 4 + WebKitGTK 6)
gir1.2-gtk-4.0
gir1.2-webkit-6.0

# Säkerhetsnät
btrfs-progs
snapper
